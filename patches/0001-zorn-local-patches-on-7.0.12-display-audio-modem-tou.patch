+	req->install_status = QMI_RESULT_SUCCESS_V01;
+	req->filter_index_list_len = 0;
+	if (count) {
+		req->rule_id_valid = 1;
+		req->rule_id_len = count;
+		memcpy(req->rule_id, rule_id, count * sizeof(*rule_id));
