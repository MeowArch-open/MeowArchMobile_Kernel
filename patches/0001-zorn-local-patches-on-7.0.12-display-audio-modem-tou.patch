+static int qcom_battmgr_sm8650_parse_uvdm_words(const char *hex, u32 *words)
+{
+	int i, j;
+
+	if (strlen(hex) != USBPD_UVDM_HEX_LEN)
+		return -EINVAL;
+
+	for (i = 0; i < USBPD_UVDM_WORDS; i++) {
+		u32 word = 0;
+
+		for (j = 0; j < 8; j++) {
+			int nibble = hex_to_bin(hex[i * 8 + j]);
+
+			if (nibble < 0)
+				return -EINVAL;
+			word = (word << 4) | nibble;
+		}
+		words[i] = word;
+	}
+
+	return 0;
+}
