+					       struct qmi_txn *txn,
+					       const void *buf, size_t len)
+{
+	struct ipa_install_filter_rule_rsp *rsp;
+	const u8 *msg = buf;
+	size_t off = sizeof(struct qmi_header);
+	u32 count = 0;
+	int ret;
