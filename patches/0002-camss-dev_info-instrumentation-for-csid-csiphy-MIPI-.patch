From c1f0e26ef88f1f235670d09387563c12fbff6b3f Mon Sep 17 00:00:00 2001
From: xingguangcuican6666 <xingguangcuican666@foxmail.com>
Date: Mon, 21 Sep 2026 22:42:19 +0800
Subject: [PATCH 2/6] camss: dev_info instrumentation for csid/csiphy MIPI
 debug (zorn cam bring-up)

---
 drivers/media/platform/qcom/camss/camss-csid-gen3.c      | 6 ++++++
 drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c | 4 ++++
 2 files changed, 10 insertions(+)

diff --git a/drivers/media/platform/qcom/camss/camss-csid-gen3.c b/drivers/media/platform/qcom/camss/camss-csid-gen3.c
index 0fdbf75fb27db35fec508996ab3adc1080742c3b..b6659c7d0bc49622719730c34dc8cd2f164abe36 100644
--- a/drivers/media/platform/qcom/camss/camss-csid-gen3.c
+++ b/drivers/media/platform/qcom/camss/camss-csid-gen3.c
@@ -273,11 +273,17 @@ static irqreturn_t csid_isr(int irq, void *dev)
 	buf_done_val = readl(csid->base + CSID_BUF_DONE_IRQ_STATUS);
 	writel(buf_done_val, csid->base + CSID_BUF_DONE_IRQ_CLEAR);
 
+	dev_info_ratelimited(csid->camss->dev,
+		"CSIDDBG: rx_irq=0x%08x buf_done=0x%08x en_vc=0x%x\n",
+		val, buf_done_val, csid->phy.en_vc);
+
 	/* Read and clear IRQ status for each enabled RDI channel */
 	for (i = 0; i < MSM_CSID_MAX_SRC_STREAMS; i++)
 		if (csid->phy.en_vc & BIT(i)) {
 			val = readl(csid->base + CSID_CSI2_RDIN_IRQ_STATUS(i));
 			writel(val, csid->base + CSID_CSI2_RDIN_IRQ_CLEAR(i));
+			dev_info_ratelimited(csid->camss->dev,
+				"CSIDDBG: rdi%d irq=0x%08x\n", i, val);
 
 			if (val & RUP_DONE_IRQ_STATUS)
 				/* clear the reg update bit */
diff --git a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
index dac8d2ecf79957dc05c5524dc439791ce097c785..c5d75f4283fd09a5a6cc542c262e2dad50211494 100644
--- a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
@@ -1160,6 +1160,10 @@ static void csiphy_lanes_enable(struct csiphy_device *csiphy,
 
 	settle_cnt = csiphy_settle_cnt_calc(link_freq, csiphy->timer_clk_rate);
 
+	dev_info(csiphy->camss->dev,
+		"CSIPHYDBG: link_freq=%lld settle_cnt=%u lane_mask=0x%x num_data=%d timer_clk=%u\n",
+		link_freq, settle_cnt, lane_mask, c->num_data, csiphy->timer_clk_rate);
+
 	val = CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
 	for (i = 0; i < c->num_data; i++)
 		val |= BIT(c->data[i].pos * 2);
